  "S1": {
    "antipadrao": "AP2",
    "titulo": "3 subconsultas escalares sobre Posts por usuario (4.020 usuarios)",
    "sql_original": "SELECT u.Id, u.DisplayName,\n  (SELECT COUNT(*) FROM dbo.Posts p WHERE p.OwnerUserId = u.Id) AS Qtd,\n  (SELECT MAX(p.Score) FROM dbo.Posts p WHERE p.OwnerUserId = u.Id) AS MaxScore,\n  (SELECT SUM(p.ViewCount) FROM dbo.Posts p WHERE p.OwnerUserId = u.Id) AS Views\nFROM dbo.Users u WHERE u.Reputation >= 20000",
    "sql_reescrita": "SELECT u.Id, u.DisplayName, COUNT(p.Id) AS Qtd, MAX(p.Score) AS MaxScore, SUM(p.ViewCount) AS Views\nFROM dbo.Users u LEFT JOIN dbo.Posts p ON p.OwnerUserId = u.Id\nWHERE u.Reputation >= 20000 GROUP BY u.Id, u.DisplayName",
