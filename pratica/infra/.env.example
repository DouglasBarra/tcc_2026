# Copie para .env (cp .env.example .env) e ajuste. O .env NAO deve ser versionado.
# Senha SA: minimo 8 caracteres, 3 de 4 classes (maiuscula, minuscula, digito, simbolo).
MSSQL_SA_PASSWORD=TroqueEstaSenha#2026
MSSQL_PID=Developer
MSSQL_PORT=1433
# Limite de memoria do SQL Server dentro do container (MB). Minimo oficial do container: 2 GB.
MSSQL_MEMORY_LIMIT_MB=4096
MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS
TZ=America/Sao_Paulo
# Banco usado nos experimentos
TCC_DB=tcc_lab
